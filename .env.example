# ===== SERVER (server/.env) =====
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ganesh_prasad_portal

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# CORS - the URL of the client app
CLIENT_URL=http://localhost:5173

# Seed admin account (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_ADMIN_NAME=Portal Admin

# Rate limiting
PUBLIC_APPLY_RATE_LIMIT_WINDOW_MIN=15
PUBLIC_APPLY_RATE_LIMIT_MAX=10

# ===== CLIENT (client/.env) =====
# VITE_API_BASE_URL=http://localhost:5000/api
